<Project Sdk="Microsoft.NET.Sdk">
  <!-- Session, vault and clipboard logic. No UI references, so it is fully unit-testable. -->
  <PropertyGroup>
    <RootNamespace>BitwardenCommandPalette.Core</RootNamespace>
    <!-- The LibraryImport source generator for WinVerifyTrust emits pointer code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BitwardenCommandPalette.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows lock, sleep and sign-out events (ADR 9). -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>
</Project>
